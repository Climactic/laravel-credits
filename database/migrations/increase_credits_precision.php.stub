        $creditsTable = config('credits.table_name', 'credits');
        $accountsTable = config('credits.accounts_table_name', 'credit_accounts');

        if (Schema::hasTable($creditsTable)) {
            Schema::table($creditsTable, function (Blueprint $table) use ($precision) {
                $table->decimal('amount', $precision, 2)->change();
                $table->decimal('running_balance', $precision, 2)->change();
            });
        }

        if (Schema::hasTable($accountsTable)) {
            Schema::table($accountsTable, function (Blueprint $table) use ($precision) {
                $table->decimal('balance', $precision, 2)->default(0)->change();
            });
        }
